<?xml version="1.0"?>
<model>
  <name>ground_lidar_sensor_os1_128</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Ground-fixed Ouster OS1 (Standard Range) equivalent: 128-channel 360° LiDAR
    for competition drone localization (outside-in, side-view mount).
    Narrower vertical FOV (42.4°) and much longer range (170m @ 80% reflectivity)
    than the OS0-SR model — placement geometry must be recalculated separately,
    this model file only encodes the sensor's own specs.
    Pose is set at spawn time via the launch file arguments.
  </description>
</model>
