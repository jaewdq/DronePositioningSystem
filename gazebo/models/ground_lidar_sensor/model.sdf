<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="ground_lidar_sensor_os1_128">
    <!-- Static stand: position set externally at spawn time -->
    <static>true</static>

    <link name="base">
      <!-- Support pole from ground up to the sensor.
           Model origin sits at the sensor height (spawn z), so the pole
           is centred half its length below the origin to reach the floor.
           For the default spawn z=2.5, length 2.5 → spans floor(0)→sensor. -->
      <visual name="pole">
        <pose>0 0 -1.25 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>2.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR housing: cyan/blue cylinder (distinct from the OS0-SR model's
           orange) so the two sensor types are visually distinguishable in
           the GUI when comparing layouts. -->
      <visual name="housing">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.45 0.9 1</ambient>
          <diffuse>0.05 0.5 1.0 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <emissive>0.0 0.15 0.3 1</emissive>
        </material>
      </visual>

      <!-- Small white cap on top to indicate the scan optics -->
      <visual name="cap">
        <pose>0 0 0.09 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.85 1</ambient>
          <diffuse>0.9 0.9 0.95 1</diffuse>
        </material>
      </visual>

      <!--
        Ouster OS1 (Standard Range) 128-channel equivalent
        Horizontal: 360°, 1024 samples (~0.35° step)
        Vertical:   ±21.2° (42.4° FOV), 128 channels → ~0.33° step
                    (about HALF the OS0-SR's 90.8° vertical FOV — this is
                    the tradeoff for higher channel density / longer range.
                    Ground-sensor placement geometry designed around the
                    OS0-SR's wide FOV does NOT carry over and must be
                    re-derived for this narrower cone.)
        Range:      0.1 – 170 m (170m = 80% Lambertian reflectivity spec;
                    min range per datasheet is ">0m", 0.1m used here as a
                    practical simulation floor)
        Rate:       10 Hz
        Noise:      Gaussian σ = 0.005 m (0.5 cm precision per datasheet)

        IMPORTANT: a gpu_lidar sensor publishes TWO gz topics derived from
        <topic>:
          <topic>            → gz.msgs.LaserScan        (2D scan)
          <topic>/points     → gz.msgs.PointCloudPacked (3D cloud)
        So we set <topic>/lidar1</topic> (or /lidar2 for the second unit) and
        the 3D cloud lands on gz topic /lidar1/points, which ros_gz_bridge
        maps to the ROS2 /lidar1/points topic the tracker node subscribes to
        (naming matches the real-hardware convention used by
        lidar_extrinsic_calib).
      -->
      <sensor name="os1_128_lidar" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <!-- base topic; 3D cloud is auto-published on <topic>/points.
             Placeholder here — generate_competition_map.py sets the real
             per-instance topic (/lidar1 or /lidar2) when spawning two of these. -->
        <topic>/lidar1</topic>
        <!-- frame_id used in PointCloud2 header after bridging -->
        <gz_frame_id>lidar1_frame</gz_frame_id>
        <!-- Show the laser rays in the gz sim GUI (direct child of <sensor>).
             Set to false if the 128×1024 ray fan slows the GUI down. -->
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265358979</min_angle>
              <max_angle>3.14159265358979</max_angle>
            </horizontal>
            <vertical>
              <samples>128</samples>
              <resolution>1</resolution>
              <!-- Ouster OS1 vertical FOV: ±21.2° = ±0.37001 rad -->
              <min_angle>-0.37001</min_angle>
              <max_angle>0.37001</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>170.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>
