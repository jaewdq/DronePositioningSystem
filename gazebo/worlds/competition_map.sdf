<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="competition_map">
    <!--
      격자 교차점 전체 좌표 (X x Y, m), 원점(0,0)=이착륙 지점:
        x=0.0: (0.0,0.0), (0.0,3.0), (0.0,6.0), (0.0,9.0), (0.0,12.0), (0.0,15.0)
        x=3.0: (3.0,0.0), (3.0,3.0), (3.0,6.0), (3.0,9.0), (3.0,12.0), (3.0,15.0)
        x=6.0: (6.0,0.0), (6.0,3.0), (6.0,6.0), (6.0,9.0), (6.0,12.0), (6.0,15.0)
        x=9.0: (9.0,0.0), (9.0,3.0), (9.0,6.0), (9.0,9.0), (9.0,12.0), (9.0,15.0)
        x=12.0: (12.0,0.0), (12.0,3.0), (12.0,6.0), (12.0,9.0), (12.0,12.0), (12.0,15.0)
        x=15.0: (15.0,0.0), (15.0,3.0), (15.0,6.0), (15.0,9.0), (15.0,12.0), (15.0,15.0)
        x=18.0: (18.0,0.0), (18.0,3.0), (18.0,6.0), (18.0,9.0), (18.0,12.0), (18.0,15.0)
        x=21.0: (21.0,0.0), (21.0,3.0), (21.0,6.0), (21.0,9.0), (21.0,12.0), (21.0,15.0)
        x=24.0: (24.0,0.0), (24.0,3.0), (24.0,6.0), (24.0,9.0), (24.0,12.0), (24.0,15.0)

      마커(경로점) 배치 좌표:
        id=1: (3.0, 3.0)
        id=2: (3.0, 12.0)
        id=3: (21.0, 3.0)
        id=4: (9.0, 9.0)
    -->

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.5 0.5 0.5 1</ambient>
      <!-- <sky>가 렌더링되면 background는 가려지지만, 스카이돔을 지원하지
           않는 렌더러/헤드리스에서는 이 하늘색이 그대로 배경이 된다. -->
      <background>0.53 0.72 0.92 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>2.5</speed>
          <direction>0.7</direction>
          <humidity>0.55</humidity>
          <mean_size>0.35</mean_size>
        </clouds>
      </sky>
    </scene>

    <!-- 바닥(먼 배경 + 충돌면): 잔디 텍스처 박스 바깥으로 이어지는 벌판.
         텍스처 없이 잔디색 단색이라 지평선까지 자연스럽게 이어진다. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.24 0.34 0.16 1</ambient>
            <diffuse>0.40 0.55 0.26 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- 잔디 바닥 (경기장 + 여유 6.0m, 타일링 텍스처).
         상단면이 정확히 z=0.001가 되도록 두께 절반만큼 내려서 배치. -->
    <include>
      <uri>model://arena_ground</uri>
      <name>arena_ground</name>
      <pose>12.0 7.5 0.0 0 0 0</pose>
    </include>

    <!-- 이착륙 지점(원점, world 좌표 0,0) 표시 패드.
         바닥이 잔디(녹색)라 기존 녹색 패드는 묻혀서 안 보이므로 흰색 계열로. -->
    <model name="home_pad">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.001</length></cylinder>
          </geometry>
          <material>
            <ambient>0.90 0.90 0.88 1</ambient>
            <diffuse>0.98 0.98 0.96 1</diffuse>
            <emissive>0.22 0.22 0.20 1</emissive>
          </material>
        </visual>
      </link>
    </model>

