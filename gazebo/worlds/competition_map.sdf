    <!-- 경로점 ArUco 마커 4개 (DICT_4X4_50, 0.5m x 0.5m), 경계에서 1셀 이상 안쪽 -->

    <!-- 경로점 id=1: (3.0, 3.0) -->
    <include>
      <uri>model://aruco_marker_id1_at_x3_y3</uri>
      <name>aruco_marker_id1_at_x3_y3</name>
      <pose>3.0 3.0 0.005 0 0 0</pose>
    </include>
    <!-- 경로점 id=2: (3.0, 12.0) -->
    <include>
      <uri>model://aruco_marker_id2_at_x3_y12</uri>
      <name>aruco_marker_id2_at_x3_y12</name>
      <pose>3.0 12.0 0.005 0 0 0</pose>
    </include>
    <!-- 경로점 id=3: (21.0, 3.0) -->
    <include>
      <uri>model://aruco_marker_id3_at_x21_y3</uri>
      <name>aruco_marker_id3_at_x21_y3</name>
      <pose>21.0 3.0 0.005 0 0 0</pose>
    </include>
    <!-- 경로점 id=4: (9.0, 9.0) -->
    <include>
      <uri>model://aruco_marker_id4_at_x9_y9</uri>
      <name>aruco_marker_id4_at_x9_y9</name>
      <pose>9.0 9.0 0.005 0 0 0</pose>
    </include>

    <!-- 지상 고정 LiDAR 2대 (OS1-128, 호버 구간 전용, 33x23 금지구역 밖) -->

    <!-- 지상 고정 LiDAR(OS1-SR 128ch): ground_lidar_1 @ world (12.0, -2.0, 2.0), yaw=1.5708 rad, topic /lidar1/points -->
    <model name="ground_lidar_1">
      <static>true</static>
      <pose>12.0 -2.0 2.0 0.0 0.0 1.5708</pose>
      <link name="base">
        <visual name="pole">
          <pose>0 0 -1.0 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.04</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="housing">
          <geometry>
            <cylinder><radius>0.09</radius><length>0.16</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.45 0.9 1</ambient>
            <diffuse>0.05 0.5 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
            <emissive>0.0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <visual name="cap">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.07</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.85 1</ambient>
            <diffuse>0.9 0.9 0.95 1</diffuse>
          </material>
        </visual>
        <sensor name="ground_lidar_1_lidar" type="gpu_lidar">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/lidar1</topic>
          <gz_frame_id>ground_lidar_1_frame</gz_frame_id>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>1024</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265358979</min_angle>
                <max_angle>3.14159265358979</max_angle>
              </horizontal>
              <vertical>
                <samples>128</samples>
                <resolution>1</resolution>
                <min_angle>-0.37001</min_angle>
                <max_angle>0.37001</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.3</min>
              <max>85.0</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
    </model>
    <!-- 지상 고정 LiDAR(OS1 128ch): ground_lidar_2 @ world (12.0, 17.0, 2.0), yaw=-1.5708 rad, topic /lidar2/points -->
    <model name="ground_lidar_2">
      <static>true</static>
      <pose>12.0 17.0 2.0 0.0 0.0 -1.5708</pose>
      <link name="base">
        <visual name="pole">
          <pose>0 0 -1.0 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.04</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="housing">
          <geometry>
            <cylinder><radius>0.09</radius><length>0.16</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.45 0.9 1</ambient>
            <diffuse>0.05 0.5 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
            <emissive>0.0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <visual name="cap">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.07</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.85 1</ambient>
            <diffuse>0.9 0.9 0.95 1</diffuse>
          </material>
        </visual>
        <sensor name="ground_lidar_2_lidar" type="gpu_lidar">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/lidar2</topic>
          <gz_frame_id>ground_lidar_2_frame</gz_frame_id>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>1024</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265358979</min_angle>
                <max_angle>3.14159265358979</max_angle>
              </horizontal>
              <vertical>
                <samples>128</samples>
                <resolution>1</resolution>
                <min_angle>-0.37001</min_angle>
                <max_angle>0.37001</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>170.0</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
