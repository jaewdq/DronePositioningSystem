<sdf version="1.9"><model name="ground_lidar_2">
      <static>true</static>
      <pose>12.0 16.5 2.0 0.0 0.0 -1.5708</pose>
      <link name="base">
        <visual name="pole">
          <pose>0 0 -1.0 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.04</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="housing">
          <geometry>
            <cylinder><radius>0.09</radius><length>0.16</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.45 0.9 1</ambient>
            <diffuse>0.05 0.5 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
            <emissive>0.0 0.15 0.3 1</emissive>
          </material>
        </visual>
        <visual name="cap">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.07</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.85 1</ambient>
            <diffuse>0.9 0.9 0.95 1</diffuse>
          </material>
        </visual>
        <sensor name="ground_lidar_2_lidar" type="gpu_lidar">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/lidar2</topic>
          <gz_frame_id>ground_lidar_2_frame</gz_frame_id>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>512</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265358979</min_angle>
                <max_angle>3.14159265358979</max_angle>
              </horizontal>
              <vertical>
                <samples>128</samples>
                <resolution>1</resolution>
                <min_angle>-0.37001</min_angle>
                <max_angle>0.37001</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>170.0</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
    </model>
</sdf>
