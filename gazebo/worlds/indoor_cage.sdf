<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="indoor_cage">
    <!--
      원점(0,0) = 필드 남서 모서리 = 이륙 지점
      필드  x 0~3.0, y 0~2.0
      케이지 x -1.0~4.0, y -1.0~3.0  (5.0 x 4.0 m, 높이 3.5 m)
      ground_lidar_1 (/lidar1): (1.5, -0.7, 1.2)
      ground_lidar_2 (/lidar2): (1.5, 2.7, 1.2)
    -->

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.85 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 실내 바닥 (흰색, 충돌면). 회색 타일은 floor_tiles가 위에 깐다 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
          <surface>
            <friction><ode/></friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 바닥 타일 (0.3 m 흰색/회색 체커, 원점이 타일 모서리) -->

    <model name="floor_tiles">
      <static>true</static>
      <link name="link">
        <visual name="t_-5_-4"><pose>-1.350 -1.050 0.00025 0 0 0</pose><geometry><box><size>0.3 0.3 0.0005</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
