Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: grid
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 3
      Plane Cell Count: 10
      Color: 100; 100; 100
      Reference Frame: grid
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 2
    - Class: rviz_default_plugins/MarkerArray
      Name: CalibrationMarkers
      Enabled: true
      Topic:
        Value: /calibration_viz_node/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointStamped
      Name: Sensor1Grid
      Enabled: true
      Color: 25; 153; 255
      Radius: 0.3
      History Length: 50
      Topic:
        Value: /sensor1/target_point_grid
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointStamped
      Name: Sensor2Grid
      Enabled: true
      Color: 255; 140; 25
      Radius: 0.3
      History Length: 50
      Topic:
        Value: /sensor2/target_point_grid
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45
      Focal Point:
        X: 12
        Y: 7.5
        Z: 0
      Pitch: 1.35
      Yaw: 4.71
